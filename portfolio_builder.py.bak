# ── Smart stock quality scores for optimizer ──────────────────────────────────
# Based on ROE, margins, growth, D/E from Yahoo Finance
# Used to set optimizer weight bounds — better stocks get higher max allocation

@st.cache_data(ttl=86400, show_spinner=False)
def get_stock_quality_scores(tickers_tuple):
    """
    Fetch key financial ratios and compute a quality score (0-100) for each stock.
    Higher score = optimizer can allocate more weight to it.
    """
    import yfinance as yf
    scores = {}
    for name, ticker in dict(tickers_tuple).items():
        try:
            t    = yf.Ticker(ticker)
            info = t.info
            roe   = info.get("returnOnEquity", 0) or 0
            npm   = info.get("profitMargins", 0)  or 0
            de    = info.get("debtToEquity", 0)   or 0
            rev_g = info.get("revenueGrowth", 0)  or 0
            pe    = info.get("trailingPE", 30)     or 30

            # Score components (0-25 each)
            roe_score   = min(25, roe*100)           # ROE > 25% = full score
            margin_score= min(25, npm*100)           # Net margin > 25% = full score
            debt_score  = max(0, 25 - de*5)         # Lower debt = better
            growth_score= min(25, max(0, rev_g*100)) # Revenue growth

            total = roe_score + margin_score + debt_score + growth_score
            scores[name] = min(100, max(0, total))
        except Exception:
            scores[name] = 50  # Default neutral score
    return scores

RISK_FREE = 0.065

